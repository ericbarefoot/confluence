[Unit]
Description=Confluence MQTT node
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=eric
WorkingDirectory=/home/eric/confluence
ExecStart=/home/eric/confluence/.venv/bin/python confluence_daemon.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
